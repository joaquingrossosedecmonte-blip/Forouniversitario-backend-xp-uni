{
  "info": {
    "_postman_id": "4ff16adf-1177-4aa5-92d9-7267551d8536",
    "name": "Foro Universitario API",
    "description": "API REST del Foro Universitario (v1).\n\nOrden sugerido: Auth > Registro, Auth > Login usuario, Auth > Login admin, luego Publicaciones. Los tokens y el id de la última publicación se guardan solos en variables de la colección.\n\nLos datos se guardan en memoria: al reiniciar el servidor se pierden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "userNombre",
      "value": "Ana Pérez"
    },
    {
      "key": "userCorreo",
      "value": "ana@universidad.com"
    },
    {
      "key": "userPassword",
      "value": "Password123"
    },
    {
      "key": "adminCorreo",
      "value": "admin@universidad.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin12345"
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "userRefreshToken",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "adminRefreshToken",
      "value": ""
    },
    {
      "key": "publicacionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{userNombre}}\",\n  \"correo\": \"{{userCorreo}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (o 409 si ya existe)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{userCorreo}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda userAccessToken y userRefreshToken. Límite: 5 intentos cada 15 minutos por correo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Requiere ADMIN_CORREO y ADMIN_PASSWORD en el .env del servidor. Guarda adminAccessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Publicaciones",
      "item": [
        {
          "name": "Crear publicación",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/publicaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Duda sobre el parcial\",\n  \"contenido\": \"¿Alguien sabe qué temas entran?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requiere token (usa userAccessToken). Guarda el id en publicacionId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('publicacionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Comentar publicación",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/publicaciones/{{publicacionId}}/comentarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Entran las unidades 1 a 3.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Votar publicación",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/publicaciones/{{publicacionId}}/votos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"positivo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reportar publicación",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/publicaciones/{{publicacionId}}/reportes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Contenido inapropiado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar publicación (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/publicaciones/{{publicacionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Requiere rol ADMIN: ejecutá antes Auth > Login admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Prueba de acceso admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/prueba",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}