{
  "name": "foro-universitario-backend",
  "version": "1.0.0",
  "description": "Backend del Foro Universitario desarrollado con TypeScript, Express, Prisma y BDD con Cucumber aplicando prácticas de XP.",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js",
    "test:e2e": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "prisma": "^8.0.0-rc.15",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
